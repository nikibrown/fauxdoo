{
  "name": "fauxdoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cf": "opennextjs-cloudflare build && wrangler dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier": "3.9.9",
    "typescript": "^5",
    "wrangler": "^4.14.0"
  }
}
